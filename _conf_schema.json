{
  "log_with_bot_id": {
    "description": "日志区分机器人实例",
    "type": "bool",
    "default": false,
    "hint": "多 Bot 时日志前缀带平台 ID，便于定位。"
  },
  "basic_settings": {
    "description": "基础设置",
    "type": "object",
    "items": {
      "collect_enabled": {
        "description": "收集表情",
        "type": "bool",
        "default": true,
        "hint": "关掉就不再收新表情。"
      },
      "collect_all_images": {
        "description": "收全部图片",
        "type": "bool",
        "default": false,
        "hint": "群里的普通照片也一起收。只想要表情包就别开。"
      }
    }
  },
  "collect_settings": {
    "description": "收集与并发",
    "type": "object",
    "items": {
      "throttle_mode": {
        "description": "判定方式",
        "type": "string",
        "options": [
          "ratio",
          "cooldown"
        ],
        "default": "ratio",
        "hint": "按「概率」收，还是按「冷却」收——两种只能选一种，另一个的数值不生效。"
      },
      "collect_ratio": {
        "description": "概率",
        "type": "float",
        "default": 0.3,
        "hint": "每张表情有多大概率被收下来。",
        "condition": {
          "throttle_mode": "ratio"
        }
      },
      "cooldown_seconds": {
        "description": "冷却间隔（秒）",
        "type": "int",
        "default": 30,
        "hint": "两次收集之间至少隔多少秒。",
        "condition": {
          "throttle_mode": "cooldown"
        }
      },
      "worker_count": {
        "description": "并发数",
        "type": "int",
        "default": 2,
        "hint": "同时处理几张图。调大收得更快，也更吃 CPU 和识图额度。"
      },
      "max_file_mb": {
        "description": "单张体积上限（MB）",
        "type": "float",
        "default": 32,
        "hint": "超过这个大小的图直接跳过。"
      },
      "collect_blacklist": {
        "type": "list",
        "description": "收集黑名单",
        "hint": "这些会话里的图不收。填 F:好友号 只管私聊，填 G:群号 只管群聊。",
        "default": []
      }
    }
  },
  "classify_settings": {
    "description": "识别与入库",
    "type": "object",
    "items": {
      "vision_provider_id": {
        "description": "识别模型",
        "type": "string",
        "default": "",
        "_special": "select_provider",
        "hint": "用哪个模型给表情打标签。留空就用全局的图片描述模型；都没有时只入库、不打标签。"
      },
      "review_enabled": {
        "description": "开启审核",
        "type": "bool",
        "default": true,
        "hint": "新收的表情先进「待审核」，你点了通过才发得出去。关掉就是收到就能用。"
      },
      "library_cap": {
        "description": "存储上限",
        "type": "int",
        "default": 800,
        "hint": "最多存多少张。满了先删用得最少的，收藏和导入的不删。"
      }
    }
  },
  "send_settings": {
    "description": "发表情",
    "type": "object",
    "items": {
      "send_enabled": {
        "description": "自动发表情",
        "type": "bool",
        "default": true,
        "hint": "关掉后不再自动配表情。模型仍可以自己调工具发（要开下面的「主动发送工具」）。"
      },
      "send_tools_enabled": {
        "type": "bool",
        "description": "主动发送工具",
        "hint": "让模型能自己搜表情、自己决定发哪张。关掉后只剩「回复完自动配一张」这条路。",
        "default": true
      },
      "send_ratio": {
        "description": "发送概率",
        "type": "float",
        "default": 0.25,
        "hint": "条件都满足之后，有多大概率真的发出去。"
      },
      "send_delay_seconds": {
        "description": "发送延迟（秒）",
        "type": "int",
        "default": 5,
        "hint": "回复发出去后等几秒再配图。填 0 就是立刻发。"
      },
      "send_cooldown_seconds": {
        "description": "会话冷却（秒）",
        "type": "int",
        "default": 120,
        "hint": "同一个会话两次发表情至少隔多久。填 0 不限制。"
      },
      "send_compress": {
        "description": "发送前压缩",
        "type": "bool",
        "default": true,
        "hint": "发之前压成表情包的尺寸，原图仍然保留。"
      },
      "send_whitelist": {
        "description": "发送白名单",
        "type": "list",
        "default": [],
        "hint": "只在列出的会话里发。留空表示所有会话都发。填 F:好友号 或 G:群号，别的写法不认。"
      },
      "persona_isolation": {
        "description": "人格隔离",
        "type": "bool",
        "default": true,
        "hint": "绑了人格的表情，只由那个人格发出来。"
      }
    }
  },
  "semantic_settings": {
    "description": "语义索引",
    "type": "object",
    "items": {
      "embedding_enabled": {
        "type": "bool",
        "description": "语义检索",
        "hint": "按意思挑图，比按字面匹配准得多。需要先在「模型提供商」里配一个向量模型。",
        "default": false
      },
      "embedding_provider_id": {
        "type": "string",
        "description": "向量模型提供商 ID",
        "hint": "留空自动用第一个向量模型。",
        "default": ""
      },
      "label_extraction": {
        "type": "string",
        "description": "标签来源",
        "hint": "判断「这句话是什么情绪」的方式：按标签表比对（不花钱），或者让模型判断（更准，每条多一次调用）。",
        "default": "vector",
        "options": [
          "vector",
          "llm"
        ],
        "labels": [
          "标签向量",
          "LLM 萃取"
        ]
      },
      "min_keyword_score": {
        "type": "float",
        "description": "关键词兜底的最低分",
        "hint": "没开语义检索时，靠关键词匹配的及格线。分数太低说明这句话和库里哪张都不搭，宁可不发。填 0 就是不设限，有候选就发。",
        "default": 2.0
      },
      "pick_variety": {
        "type": "string",
        "description": "选图变化程度",
        "options": [
          "stable",
          "balanced",
          "lively"
        ],
        "labels": [
          "稳一点",
          "适中",
          "活泼"
        ],
        "default": "balanced",
        "hint": "同一句话连发几次，要不要换张图。选「稳一点」基本老发同一张，「活泼」会常换——但换的也都是分数接近的，不会发不相关的。"
      }
    }
  }
}
